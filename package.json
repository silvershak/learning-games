{
  "name": "learning-games",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side Hebrew learning games for kids (static, no build step).",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:html": "html-validate \"app/**/*.html\"",
    "check:links": "linkinator app --recurse --skip \"^https?://(?!localhost)\"",
    "dev": "http-server app -p 8000 -c-1",
    "check": "npm run lint && npm run format:check && npm run validate:html"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "html-validate": "^9.0.0",
    "http-server": "^14.1.1",
    "linkinator": "^6.1.0",
    "prettier": "^3.3.3"
  }
}
